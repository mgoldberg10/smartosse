#                  'SPforcT1','SPforcS1',
   filename(3) = 'diags/budg2d_zflux_set1',
   fileFlags(3) = 'D       ',
####---
#### TLFUX: heat flux at rF=0 (k=1, lower edge of vertical, where 
####        k incr downward); positive is defined in opposite dir
####        of k, so + upward); unit J/s/m2; inclusive of oceQsw
#### SFLUX: salt flux at rF=0; unit g/s/m2; EXCLUSIVE of oceSPflx
  frequency(16) = 600.0,
   fields(1:2,16) = 'lTFLUX  ','lSFLUX  ',
   filename(16) = 'diags/budg2d_zflux_layers_set1',
   fileFlags(16) = 'D       ',
