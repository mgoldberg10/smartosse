   fields(1:2,2) = 'THETADR ','SALTDR  ',
   filename(2) = 'diags/budg3d_snap_set2',
   timePhase(2)= 0.,
   fileFlags(2) = 'D       ',
####---
#### ltot[T,S]tnd: tendency, the LHS, unit degC/s or psu/s
#### lgTocQsw: from gT of Qsw (I believe this is the surface total)
#### locSPtnd: this is the salt fraction (oceSPtnd) that goes into each
####           depth layer; unit g/s/m2, such that sum(oceSPtnd)=oceSPflx
#### locQsw3D: heat fraction (oceQsw*swfrac(k)-oceQsw*swfrac(k+1)) goes
####           into each depth layer; unit J/s/m2, sum(oceQsw3D)=oceQsw
  frequency(15) = 600.0,
   fields(1:6,15) = 'ltotTtnd','ltotStnd','lgTocQsw','locSPtnd',
                    'locQsw3D','ltotEtnd',
   filename(15) = 'diags/budg3d_tend_layers_set1',
   fileFlags(15) = 'D       ',
####---
  frequency(3) = 600.0,
