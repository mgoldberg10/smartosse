def plot_sigma_patm_map(
    sigma,
    ax=None,
    cable_lonlat=None,     # dict[region] -> (lons, lats); omit to skip cable overlay
    region_colors=None,
    cmap='Greys',
    hpa=True,
    add_colorbar=True,
    cbar_kwargs=None,
    scatter_kwargs=None,
    **contourf_kwargs,
):
    """sigma_patm map on the SPNA projection, optionally with per-region cable markers.

    `sigma` is a lat/lon (JRA55-grid) DataArray in Pa, e.g. from
    load_sigma_patm_std_map()/load_sigma_patm_spread_map() -- these are
    plotted directly (xarray contourf + PlateCarree transform), unlike the
    ASTE-gridded weight-derived fields which need `ds.plotpc`. vmin/vmax/
    levels are left to xarray's own robust scaling unless passed via
    contourf_kwargs -- the STD and SPREAD fields differ by ~5-10x in
    magnitude, so a shared hardcoded range would make one panel look empty.
    """
    if ax is None:
        fig, ax = spna()
    else:
        fig = ax.figure

    field = sigma / 100. if hpa else sigma

    ck = dict(cmap=cmap, add_colorbar=False, transform=ccrs.PlateCarree(), robust=True)
    ck.update(contourf_kwargs)
    p = field.plot.contourf(ax=ax, **ck)

    cb = None
    if add_colorbar:
        cbk = dict(orientation='horizontal', shrink=0.8, pad=0.05)
        cbk.update(cbar_kwargs or {})
        cb = fig.colorbar(p, ax=ax, **cbk)
        cb.ax.set_xlabel('[hPa]' if hpa else '[Pa]', fontsize=16)

    if cable_lonlat is not None:
        region_colors = region_colors or REGION_COLORS
        sk = dict(s=20, edgecolor='w', linewidth=0.5, transform=ccrs.PlateCarree(), zorder=4)
        sk.update(scatter_kwargs or {})
        for region, (lons, lats) in cable_lonlat.items():
            ax.scatter(lons, lats, facecolor=region_colors.get(region, 'k'), **sk)

    return ax, cb, p


def plot_relcon_bars(
    relcon,
    ax=None,
    colors=None,
    group_order=RELCON_GROUP_ORDER,
    width=0.5,
    legend=True,
    **bar_kwargs,
):
    """Panel (g): stacked relcon bars, one bar per run (dict key), stacked by group.

    `relcon` : dict[str, xr.DataArray] with a 'group' dim (e.g. from
    load_relcon_std_spread()), values summing to ~1 per run.
    """
    if ax is None:
        fig, ax = plt.subplots(figsize=(2.4, 4))
    else:
        fig = ax.figure

    colors = colors or RELCON_GROUP_COLORS
    run_names = list(relcon.keys())
    x = np.arange(len(run_names))

    for xi, run_name in zip(x, run_names):
        bottom = 0.
        da = relcon[run_name]
        for group in group_order:
            val = float(da.sel(group=group))
            ax.bar(xi, val, width, bottom=bottom, color=colors[group],
                   edgecolor='k', linewidth=0.5, **bar_kwargs)
            bottom += val

    ax.set_xticks(x)
    ax.set_xticklabels(run_names)
    ax.set_ylim(0, 1)
    ax.set_ylabel('relative contribution')
    ax.grid(axis='y', alpha=0.3)

    if legend:
        handles = [Patch(facecolor=colors[g], edgecolor='k', label=g) for g in group_order]
        ax.legend(handles=handles, frameon=False, fontsize=9,
                  loc='upper center', bbox_to_anchor=(0.5, -0.12), ncol=1)

    return ax


def plot_relcon_bars_region(
    ax,
    relcon_std,       # DataArray[group], sums to 1
    relcon_spread,    # DataArray[group], sums to 1
    group_order=RELCON_GROUP_ORDER,
    colors=None,
    height=0.6,
    spread_hatch=None,
    tick_fontsize=16,
    ylabel_fontsize=None,
    **barh_kwargs,
):
    """Row 3: one region's STD/SPREAD relcon as a pair of horizontal stacked
    bars (STD above, SPREAD below), winds/patm/other, each summing to 1.

    The y-tick labels ('STD'/'SPREAD') are what distinguish the two rows;
    pass `spread_hatch` (e.g. '///') to also hatch SPREAD if the labels alone
    aren't enough (e.g. grayscale printing, cropped screenshot) -- off by
    default since it's redundant once the labels are legible. `ylabel_fontsize`
    (defaults to `tick_fontsize` if omitted) sets just the STD/SPREAD y-tick
    labels, independent of the x-tick (0/0.5/1) fontsize.
    """
    colors = colors or RELCON_GROUP_COLORS
    ylabel_fontsize = tick_fontsize if ylabel_fontsize is None else ylabel_fontsize

    for y, relcon, hatch in [(1, relcon_std, None), (0, relcon_spread, spread_hatch)]:
        left = 0.
        for group in group_order:
            val = float(relcon.sel(group=group))
            ax.barh(y, val, height=height, left=left, color=colors[group],
                     edgecolor='k', linewidth=0.5, hatch=hatch, **barh_kwargs)
            left += val

    ax.set_xlim(0, 1)
    ax.set_ylim(-0.6, 1.6)
    ax.set_yticks([1, 0])
    ax.set_yticklabels(['STD', 'SPREAD'])
    ax.set_xticks([0, 0.5, 1])
    ax.tick_params(axis='both', labelsize=tick_fontsize)
    ax.tick_params(axis='y', labelsize=ylabel_fontsize, length=0)
    for spine in ('top', 'right'):
        ax.spines[spine].set_visible(False)

    return ax


def plot_relcon_bars_row(axes, relcon_per_region, regions=REGIONS, **region_kwargs):
    """Row 3: call plot_relcon_bars_region() once per cable across `axes`.

    `relcon_per_region` is load_relcon_per_region()'s return value -- {'std':
    {region: DataArray[group]}, 'spread': {region: DataArray[group]}}.
    """
    for ax, region in zip(axes, regions):
        plot_relcon_bars_region(
            ax, relcon_per_region['std'][region], relcon_per_region['spread'][region],
            **region_kwargs,
        )

    for ax in axes[1:]:
        ax.tick_params(labelleft=False)

    return axes


def _row2_legend_handles(pd_rms_label='P&D 2003\n(SPNA)'):
    """Black-only proxy handles for row 2's STD/SPREAD/P&D/sigma-band legend.

    Built from proxies (not the actual plotted-line artists) so the legend
    swatches are always black, regardless of which region's (colored) panel
    hosts the legend -- otherwise e.g. placing it in the Newfoundland panel
    would render every swatch in Newfoundland's green.
    """
    return [
        Line2D([0], [0], color='k', label='STD', **STD_LINE_STYLE),
        Line2D([0], [0], color='k', label='SPREAD', **SPREAD_LINE_STYLE),
        Line2D([0], [0], color='k', label=latex_escape(pd_rms_label), **PD_LINE_STYLE),
        Patch(facecolor='0.5', alpha=0.3, edgecolor='none', label=SIGMA_BAND_LABEL),
    ]


def _month_day_formatter(x, pos=None):
    return mdates.num2date(x).strftime('%b\n%d')


def plot_patm_adjustment_timeseries(
    ax,
    time,
    adj_std,          # (time, sensor) or (time,), Pa
    adj_spread,        # same
    sigma_band_hpa,    # scalar half-width [hPa], e.g. from compute_sigma_band_hpa
    pd_rms_hpa=PD_2003_RMS_HPA,
    color='k',
    symmetric_band=True,
    yticks=(0, 1, 2),   # only these get labeled/gridlined; ylim still dips below 0
    ylim=None,          # e.g. (-1, 3) to share one range across all row-2 panels
    tick_labelsize=16,  # x-axis (date) tick label size; every panel has an x-axis
    band_kwargs=None,
    pd_line_kwargs=None,
    std_line_kwargs=None,
    spread_line_kwargs=None,
):
    """One Fig-9 row-2 panel: STD (solid) vs SPREAD (dashed) |dp_atm| against
    the SPREAD-based plausibility band and the P&D 2003 RMS anchor (black,
    densely dotted).
    """
    # this env's matplotlib (3.4.3) predates pandas 2.x dropping `Index[:,
    # None]` -- ax.plot()/fill_between() on a raw pd.DatetimeIndex raises
    # "Multi-dimensional indexing... no longer supported". A plain
    # datetime64 ndarray plots fine either way.
    time = np.asarray(time)
    sensor_dim = 'sensor' if 'sensor' in adj_std.dims else None

    def _mean_abs_hpa(da):
        da = np.abs(da) / 100.
        return da.mean(sensor_dim) if sensor_dim else da

    std_kwargs = dict(color=color, label='STD', **STD_LINE_STYLE)
    std_kwargs.update(std_line_kwargs or {})
    spread_kwargs = dict(color=color, label='SPREAD', **SPREAD_LINE_STYLE)
    spread_kwargs.update(spread_line_kwargs or {})

    ax.plot(time, _mean_abs_hpa(adj_std), **std_kwargs)
    ax.plot(time, _mean_abs_hpa(adj_spread), **spread_kwargs)

    lo = -sigma_band_hpa if symmetric_band else 0.
    bk = dict(color='0.5', alpha=0.3, edgecolor='none', label=SIGMA_BAND_LABEL, zorder=0)
    bk.update(band_kwargs or {})
    ax.fill_between(time, lo, sigma_band_hpa, **bk)

    pk = dict(color='k', label='P&D 2003 (SPNA)', zorder=1, **PD_LINE_STYLE)
    pk.update(pd_line_kwargs or {})
    ax.axhline(pd_rms_hpa, **pk)

    ax.set_axisbelow(True)
    t0 = pd.to_datetime(np.asarray(time)[0])
    t1 = t0 + pd.offsets.MonthEnd(0)
    ax.set_xlim(t0, t1)
    ax.xaxis.set_major_formatter(ticker.FuncFormatter(_month_day_formatter))
    ax.tick_params(axis='x', rotation=0, labelsize=tick_labelsize)
    if yticks is not None:
        ax.set_yticks(yticks)   # ylim (incl. any dip below 0) is untouched -- just no tick/gridline there
    if ylim is not None:
        ax.set_ylim(*ylim)
    ax.grid(axis='y')
    ax.grid(axis='x', linestyle='--', alpha=0.5)

    return ax


def plot_patm_adjustment_row(axes, row2_data, regions=REGIONS, region_labels=None,
                              region_colors=None, ylabel='[hPa]', **timeseries_kwargs):
    """Row 2: call plot_patm_adjustment_timeseries() once per cable across `axes`."""
    region_labels = region_labels or REGION_LABELS
    region_colors = region_colors or REGION_COLORS

    for ax, region in zip(axes, regions):
        d = row2_data[region]
        plot_patm_adjustment_timeseries(
            ax, d['time'], d['adj_std'], d['adj_spread'], d['sigma_band_hpa'],
            color=region_colors.get(region, 'k'), **timeseries_kwargs,
        )
        # no ax.set_title() -- the region name is folded into the panel
        # letter label instead (add_panel_label(..., suffix=' LS_cable')),
        # done by the caller since it also owns the letters.

    axes[0].set_ylabel(ylabel, fontsize=20)
    axes[0].tick_params(axis='y', labelsize=18)
    for ax in axes[1:]:
        ax.spines['left'].set_visible(False)
        ax.tick_params(labelleft=False)

    return axes


# =============================================================================
# Full-figure assembly -- a starting template, not a fixed API. Easiest to
# copy into a notebook and hack on directly once the panel content settles.
# =============================================================================

# (a)/(b) share one range/levels/colorbar now (both 0-3 hPa) so they're
# directly comparable at a glance -- ticks at every integer.
SIGMA_MAP_KWARGS = dict(levels=np.linspace(0, 3, 10), extend='max', robust=False)
SIGMA_MAP_CBAR_KWARGS = dict(ticks=[0, 1, 2, 3])


def make_fig9(
    ds,
    sigma_std_map=None,
    sigma_spread_map=None,
    sigma_spread=None,
    relcon_per_region=None,
    row2_data=None,
    figsize=(18, 16),
    cable_lonlat=None,
    landfacecolor='white',
):
    """Assemble the full 2-top / 4-middle / 4-bottom mosaic from already-
    loaded pieces.

    Pass in sigma_std_map/sigma_spread_map/sigma_spread/relcon_per_region/
    row2_data explicitly (e.g. from the load_* functions above) rather than
    having this function load everything itself, so a notebook can load once
    and iterate on layout/styling quickly.

    sigma_std_map/sigma_spread_map (lat/lon, from gen_patm_uncertainty_fields.py
    via load_sigma_patm_std_map()/load_sigma_patm_spread_map()) drive panels
    (a)/(b), sharing one range/colorbar (SIGMA_MAP_KWARGS for levels/extend,
    SIGMA_MAP_CBAR_KWARGS for colorbar ticks) -- edit those module constants
    (not this function) to retune. sigma_spread (ASTE grid, from
    load_sigma_patm_spread()) is a separate load -- row 2's grey band needs to
    index it at cable (tile, j, i) sensor locations, which the lat/lon map
    field can't do. relcon_per_region (from load_relcon_per_region()) drives
    row 3's per-cable STD/SPREAD bar pairs.
    """
    sigma_std_map = sigma_std_map if sigma_std_map is not None else load_sigma_patm_std_map()
    sigma_spread_map = sigma_spread_map if sigma_spread_map is not None else load_sigma_patm_spread_map()
    sigma_spread = sigma_spread if sigma_spread is not None else load_sigma_patm_spread()
    relcon_per_region = relcon_per_region if relcon_per_region is not None else load_relcon_per_region()
    row2_data = row2_data if row2_data is not None else load_row2_data(ds, sigma_spread)

    if cable_lonlat is None:
        cable_lonlat = {r: (row2_data[r]['lons'], row2_data[r]['lats']) for r in REGIONS}

    # SPNA projection center, matching smartosse.plot.spna()'s defaults
    # (xmin=-80, xmax=10 -> central_longitude=-35; ymin=40, ymax=80 ->
    # central_latitude=60). Kept in sync by hand -- if spna()'s defaults
    # change, update here too.
    spna_proj = ccrs.LambertConformal(central_longitude=-35, central_latitude=60)

    fig = plt.figure(figsize=figsize)
    # row1 height_ratio bumped 1.8 -> 2.2 (paired with figsize height 13 -> 14)
    # so (a)/(b) -- aspect-locked by the SPNA projection, so they can only
    # grow by giving their gridspec cell more height -- grow to about the
    # same combined width as the row2/row3 panels below, while barely
    # shrinking row2/row3's own height (empirically checked: this combo sits
    # right at the width cap, i.e. further height wouldn't grow them any more).
    gs_outer = fig.add_gridspec(3, 1, height_ratios=[2.2, 1, 0.45], hspace=0.4)

    # row 1: two maps, plain 1x2 split now that (g) is gone. wspace at 0 so
    # the two maps read as one wide comparison panel, not two separate ones
    # (some residual gap is inherent to cartopy's aspect-driven letterboxing
    # within each GeoAxes cell, not just the gridspec spacing -- closed below
    # via an explicit reposition once both maps are drawn).
    #
    # add_axes(rect) rather than add_subplot(subplotspec): axes made with
    # add_subplot stay tied to their SubplotSpec in this env's matplotlib
    # (3.4.3, pre Axes/Subplot unification) -- on every draw (incl. the
    # final savefig), SubplotBase.update_params() re-derives the "original"
    # box straight from the gridspec cell, silently undoing any manual
    # set_position() we do below. A plain add_axes() box has no subplotspec
    # to re-derive from, so a manual reposition sticks.
    gs_row1 = gs_outer[0].subgridspec(1, 2, wspace=0.0)
    rect_a = gs_row1[0, 0].get_position(fig).bounds
    rect_b = gs_row1[0, 1].get_position(fig).bounds
    row1_x0, _, row1_w, _ = gs_outer[0].get_position(fig).bounds
    row1_center = row1_x0 + row1_w / 2.  # full row-1 extent, i.e. same span row2/row3 sit in
    ax_a = fig.add_axes(rect_a, projection=spna_proj)
    ax_b = fig.add_axes(rect_b, projection=spna_proj)

    # decorate the map axes with spna()'s extent/land/gridlines (spna(ax=...)
    # applies its styling to an already-created GeoAxes rather than making a
    # new one, which is what lets this compose with the gridspec above).
    _, ax_a = spna(ax=ax_a, landfacecolor=landfacecolor)
    _, ax_b, gl_b = spna(ax=ax_b, landfacecolor=landfacecolor, return_gl=True)

    # (b) sits right next to (a) -- its own latitude labels would just
    # duplicate (a)'s, so hide them (longitude labels along the bottom stay).
    for label in gl_b[0]._labels:
        if 'N' in label.artist.get_text():
            label.artist.set_visible(False)

    # row 2: one timeseries panel per partial cable
    gs_row2 = gs_outer[1].subgridspec(1, 4, wspace=0.15)
    axes_row2 = [fig.add_subplot(gs_row2[0, i]) for i in range(4)]

    # row 3: one relcon STD/SPREAD bar-pair per partial cable, same 4 columns
    # as row 2 so each sits directly under its timeseries panel.
    gs_row3 = gs_outer[2].subgridspec(1, 4, wspace=0.15)
    axes_row3 = [fig.add_subplot(gs_row3[0, i]) for i in range(4)]

    # (a)/(b) share one colorbar -- both add_colorbar=False here, one shared
    # horizontal colorbar built below from either mappable (same norm/levels).
    _, _, p_a = plot_sigma_patm_map(sigma_std_map, ax=ax_a, cable_lonlat=cable_lonlat,
                                     add_colorbar=False, **SIGMA_MAP_KWARGS)
    add_panel_label(ax_a, 'a', fontsize=60)

    plot_sigma_patm_map(sigma_spread_map, ax=ax_b, cable_lonlat=cable_lonlat,
                         add_colorbar=False, **SIGMA_MAP_KWARGS)
    add_panel_label(ax_b, 'b', fontsize=60)

    # gridspec wspace=0 above isn't enough on its own -- cartopy's set_extent
    # makes each GeoAxes shrink to its own aspect-correct box and *center*
    # that box within its allocated cell, so a visible gap remains on both
    # sides of the cell boundary even at wspace=0. Fix it directly: once
    # both maps are drawn (forcing that shrink to resolve), glue them
    # together and re-center *the pair* on row1's full extent (matching
    # row2/row3's center) rather than sliding (b) next to (a)'s own natural
    # position -- (a) alone is centered only within its half of row1, which
    # is *not* row1's overall center, so that naive glue left the whole
    # (a)+(b) block visibly off-center vs. rows 2/3 below. Setting position
    # with which='both' (the default) makes this the new *original* box too,
    # so the aspect machinery doesn't re-center it away on the next
    # draw/save.
    fig.canvas.draw()
    pos_a, pos_b = ax_a.get_position(), ax_b.get_position()
    map_gap = 0.005
    combined_width = pos_a.width + map_gap + pos_b.width
    new_x0 = row1_center - combined_width / 2.
    ax_a.set_position([new_x0, pos_a.y0, pos_a.width, pos_a.height])
    ax_b.set_position([new_x0 + pos_a.width + map_gap, pos_b.y0, pos_b.width, pos_b.height])

    # Build the shared colorbar via a manually-placed `cax` rather than
    # fig.colorbar(..., ax=[ax_a, ax_b]) -- the latter's automatic
    # space-stealing resize of its parent axes silently undid the sizing/
    # centering fix above (it shrank ax_a/ax_b well below the width just
    # computed, whether done before or after the fix). A manual cax, sized
    # relative to the now-final (pos_a, pos_b), can't feed back on them.
    cbar_width = 0.6 * combined_width   # matches the old shrink=0.6 fraction
    cbar_height = 0.015
    cbar_pad = 0.03
    cax = fig.add_axes([
        row1_center - cbar_width / 2., pos_a.y0 - cbar_pad - cbar_height,
        cbar_width, cbar_height,
    ])
    cbar_ab = fig.colorbar(p_a, cax=cax, orientation='horizontal', **SIGMA_MAP_CBAR_KWARGS)
    cbar_ab.ax.set_xlabel('[hPa]', fontsize=22, labelpad=2)  # nudged up (toward the colorbar) from mpl's default labelpad=4
    cbar_ab.ax.tick_params(labelsize=20)

    plot_patm_adjustment_row(axes_row2, row2_data, ylim=(-1, 3))
    for ax, letter, region in zip(axes_row2, ['c', 'd', 'e', 'f'], REGIONS):
        add_panel_label(ax, letter, fontsize=20, x=0.04, y=0.94, suffix=f' {REGION_LABELS[region]}_cable')
    axes_row2[-1].legend(handles=_row2_legend_handles(), fontsize=18, frameon=False,
                          loc='center left', bbox_to_anchor=(1.05, 0.5), ncol=1)

    plot_relcon_bars_row(axes_row3, relcon_per_region, tick_fontsize=16, ylabel_fontsize=22)
    group_handles = [Patch(facecolor=RELCON_GROUP_COLORS[g], edgecolor='k', label=RELCON_GROUP_LABELS[g])
                      for g in RELCON_GROUP_ORDER]
    axes_row3[-1].legend(handles=group_handles, fontsize=18, frameon=False,
                          loc='center left', bbox_to_anchor=(1.05, 0.5))

    return fig, dict(a=ax_a, b=ax_b, row2=axes_row2, row3=axes_row3)
